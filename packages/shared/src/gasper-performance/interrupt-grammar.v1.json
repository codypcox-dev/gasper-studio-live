  "status": "provisional_frozen_post_d003s",
  "classes": {
    "soft": {
      "sample_actual_rendered_state": true,
      "allow_micro_ease_ms": 120,
      "start_new_plan_within_ms": 200,
      "teleport": false,
      "cancel_active_timelines": false
    },
    "hard": {
      "sample_actual_rendered_state": true,
      "cancel_active_timelines": true,
      "retain_sampled_values": true,
      "retarget_immediately": true,
      "topology_safety": true
    },
    "barrier": {
      "complete_designated_semantic_barrier_or_hold": true,
      "then_retarget": true,
      "used_when": "interruption would destroy meaning"
    },
    "morph_safe": {
      "never_illegal_topology_or_embodiment_mixture": true,
      "route_to_nearest_safe_state_before_continuing": true
    }
  },
