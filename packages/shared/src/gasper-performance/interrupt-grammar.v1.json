    "active_channel_writers",
    "playhead",
    "fixture_anchor_state",
    "document_revision",
    "document_content_hash",
    "runtime_identity"
  ],
  "retarget_algorithm": [
    "sample actual rendered state",
    "validate sample",
    "classify interrupt",
    "cancel/barrier current plan",
    "determine safe route origin",
    "compile target continuation",
    "lower from sampled values",
    "execute through GSAP",
    "record transaction and receipt"
