  "content_meta": {
    "title": "Dormant Orbit to Wake",
    "description": "Energy withdraw, collapse, orbit stabilize, dormant hold, wake, form recover, face return.",
    "intent": "Restorative continuity without death symbolism.",
    "authoring_notes": [
      "Orbit structures resolve inward on wake.",
      "Avoid spinner aesthetics."
    ],
    "visual_checkpoints": [
      {
        "time_ms": 3600,
        "label": "dormant-hold",
        "expect": "Low energy, orbit readable, identity cues retained."
      },
      {
        "time_ms": 4800,
        "label": "wake",
        "expect": "Orbit begins resolving inward."
      },
      {
        "time_ms": 7200,
        "label": "settled",
        "expect": "Presence restored."
      }
    ],
    "interruption": {
      "interruptible": true,
      "preferred_hold_state": "current-authored-hold",
      "return_route": "ease-to-neutral-settled",
      "max_interrupt_latency_ms": 120,
      "notes": "Interrupt must leave face readable; living motion may resume on permitted bindings only."
    },
    "living_motion": {
      "compatible": true,
      "permitted_bindings": [
        "energy_pulse",
        "settling",
        "relief_amplitude",
        "secondary_lag"
      ],
      "suppressed_bindings": [
        "eye_openness",
        "mouth_openness",
        "crown_height",
        "overall_width"
      ],
      "amplitude_cap": 0.08,
      "notes": "Living motion must not override authored face peaks or embodiment commitment phases."
    },
    "fallback": {
      "when_optional_missing": "Ignore optional singularity/spectral keys; keep face+macro+energy tracks.",
      "degrade_to_embodiment": "presence",
      "degrade_to_expression": "neutral-settled",
      "notes": "Always remain playable offline with required bindings only."
    },
