  "content_meta": {
    "title": "Living Presence Idle",
    "description": "Gasper is alive before interaction — slow breath, rare micro-gaze, calm availability.",
    "intent": "Prove life without distraction.",
    "authoring_notes": [
      "8s seamless loop with bounded start/end discontinuity.",
      "Amplitude kept low for UI coexistence.",
      "Compatible with living motion on energy-domain only."
    ],
    "visual_checkpoints": [
      {
        "time_ms": 0,
        "label": "available",
        "expect": "Calm face, readable eyes, no bob."
      },
      {
        "time_ms": 4800,
        "label": "breath-peak",
        "expect": "Subtle crown and glow rise."
      },
      {
        "time_ms": 8000,
        "label": "loop",
        "expect": "Near-identical to t=0."
      }
    ],
    "interruption": {
      "interruptible": true,
      "preferred_hold_state": "current-authored-hold",
      "return_route": "ease-to-neutral-settled",
      "max_interrupt_latency_ms": 120,
      "notes": "Interrupt must leave face readable; living motion may resume on permitted bindings only."
    },
    "living_motion": {
      "compatible": true,
      "permitted_bindings": [
        "energy_pulse",
        "settling",
        "relief_amplitude",
        "secondary_lag"
      ],
      "suppressed_bindings": [
        "eye_openness",
        "mouth_openness",
        "crown_height",
        "overall_width"
      ],
      "amplitude_cap": 0.08,
      "notes": "Living motion must not override authored face peaks or embodiment commitment phases."
    },
    "fallback": {
      "when_optional_missing": "Ignore optional singularity/spectral keys; keep face+macro+energy tracks.",
      "degrade_to_embodiment": "presence",
      "degrade_to_expression": "neutral-settled",
      "notes": "Always remain playable offline with required bindings only."
    },
    "loop_policy": "loop",
    "pack_id": "gasper-hero-pack-v1",
    "pack_version": "1.0.0"
  }
