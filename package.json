{
  "name": "gasper-studio-standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Gasper Studio canonical working baseline with local vector organism runtime and optional authenticated bridge transport.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run packages tests",
    "mcp:gasper": "node --import tsx packages/gasper-mcp/src/index.ts",
    "triforce:boot": "node bin/triforce.mjs boot",
    "triforce:doctor": "node bin/triforce.mjs doctor",
    "triforce:status": "node bin/triforce.mjs status"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
